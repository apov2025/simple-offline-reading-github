# 显式板型，避免把 Pico 配置写进 S31 构建。/ Explicit board selection keeps Pico settings out of S31 builds.
set(READER_BOARD "pico" CACHE STRING "Reader board: pico or metalio")
if(READER_BOARD STREQUAL "metalio")
    if(DEFINED IDF_TARGET AND NOT IDF_TARGET STREQUAL "esp32s31")
        message(FATAL_ERROR "Metalio requires IDF_TARGET=esp32s31")
    endif()
    if(NOT METALIO_PIN_PROFILE STREQUAL "plus-xstl4-mode19")
        message(FATAL_ERROR "Specify verified METALIO_PIN_PROFILE=plus-xstl4-mode19; PCB revision alone does not select wiring")
    endif()
    set(IDF_TARGET "esp32s31" CACHE STRING "" FORCE)
    set(SDKCONFIG "${CMAKE_BINARY_DIR}/sdkconfig" CACHE FILEPATH "" FORCE)
    set(SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_LIST_DIR}/../sdkconfig.metalio.defaults")
    set(READER_METALIO TRUE)
elseif(READER_BOARD STREQUAL "pico")
    if(DEFINED IDF_TARGET AND NOT IDF_TARGET STREQUAL "esp32s3")
        message(FATAL_ERROR "Pico requires IDF_TARGET=esp32s3")
    endif()
else()
    message(FATAL_ERROR "Unknown READER_BOARD")
endif()
